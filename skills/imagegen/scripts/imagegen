#!/usr/bin/env bash
# Entry point for the vendored OpenAI image CLI. Supplies its Python dependencies through uv
# (nothing to install per machine), points it at the backend that pays for the image, and says
# which model drew it and through which backend, since the vendored script does not.
# `imagegen remove-chroma-key ...` runs the alpha-extraction helper instead.
#
# Backends (IMAGEGEN_BACKEND), never swapped for one another on failure:
#   codex                   the ChatGPT plan, through this machine's own Codex login: a loopback
#                           bridge (codex_images.py) serves the Images API from the image tool of
#                           the backend Codex uses. No OpenAI key, no proxy. Needs `codex login`.
#   subscription            a claude-switch proxy's Images API routes, which pick the provider
#                           for each image (the ChatGPT plan's image tool, or another provider
#                           when that plan is spent or down): base URL from
#                           CLAUDE_SWITCH_PARENT_HTTPS_PROXY (set for every command a
#                           claude-switch session runs) or IMAGEGEN_PROXY_URL, credential from
#                           that machine's proxyAuthHelper. served_by.py runs the script and
#                           reports the provider, model and funding the proxy names per image.
#   api                     OpenAI's Image API on OPENAI_API_KEY (billed API credits).
# Unset, it is `subscription` where a switch proxy is configured and `codex` everywhere else. That
# choice is made from the environment before any call; a failure never moves to another backend.
#
# On codex the ChatGPT image tool draws with its own model (gpt-image-2-codex); --model must name a
# gpt-image model and is otherwise not forwarded, so that is what is reported. On subscription the
# proxy chooses the model with the provider, and names both for each image once it is drawn.
#
# Image classes (subscription only): the proxy draws each picture from a class, a list of providers
# it walks in order. `--class <name>` (anywhere in the arguments) or IMAGEGEN_CLASS picks one, sent
# as X-Switch-Class; unset, the proxy uses its default class, `images`. The flag is taken out before
# image_gen.py, which rejects flags it does not know. `imagegen models` prints the proxy's classes,
# their members, who can draw now and what each accepts (models.py, from the proxy's /v1/models).
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v uv >/dev/null 2>&1; then
  echo "imagegen: uv is not installed (brew install uv); refusing to run without it" >&2
  exit 1
fi

if [ "${1:-}" = "remove-chroma-key" ]; then
  shift
  exec uv run --quiet --no-project --with pillow python3 "$here/remove_chroma_key.py" "$@"
fi

# --class is the wrapper's own: take it out before anything else reads the arguments.
class="${IMAGEGEN_CLASS:-}"
class_from="IMAGEGEN_CLASS"
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --class)
      if [ $# -lt 2 ]; then
        echo "imagegen: --class needs a class name, such as images, images-runway or images-chatgpt" >&2
        exit 1
      fi
      class="$2"
      class_from="--class"
      shift 2
      ;;
    --class=*)
      class="${1#--class=}"
      class_from="--class"
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
set -- ${args[@]+"${args[@]}"}
if [ "$class_from" = "--class" ] && [ -z "$class" ]; then
  echo "imagegen: --class needs a class name, such as images, images-runway or images-chatgpt" >&2
  exit 1
fi
case "$class" in
  *[!A-Za-z0-9._-]*)
    echo "imagegen: '$class' is not a class name (letters, digits, '.', '_' and '-' only)" >&2
    exit 1
    ;;
esac

model="gpt-image-2" # image_gen.py's DEFAULT_MODEL
dry_run=""
prev=""
for arg in "$@"; do
  case "$arg" in
    --model=*) model="${arg#--model=}" ;;
    --dry-run) dry_run=1 ;;
    *) [ "$prev" = "--model" ] && model="$arg" ;;
  esac
  prev="$arg"
done

backend="${IMAGEGEN_BACKEND:-}"
if [ -z "$backend" ]; then
  if [ -n "${IMAGEGEN_PROXY_URL:-}${CLAUDE_SWITCH_PARENT_HTTPS_PROXY:-}" ]; then
    backend=subscription
  else
    backend=codex
  fi
fi
case "$backend" in
  codex) backend_says="codex: the ChatGPT plan through this machine's Codex login, drawn by gpt-image-2-codex" ;;
  subscription) backend_says="subscription: a claude-switch proxy" ;;
  api) backend_says="api: OpenAI's Image API on OPENAI_API_KEY (billed API credits)" ;;
  *)
    echo "imagegen: IMAGEGEN_BACKEND must be codex, subscription or api, not '$backend'" >&2
    exit 1
    ;;
esac
if [ -n "$class" ] && [ "$backend" != subscription ]; then
  echo "imagegen: $class_from $class: image classes exist only under the switch proxy (IMAGEGEN_BACKEND=subscription); this backend is $backend_says, which has one provider" >&2
  exit 1
fi

# The proxy's login, from the machine's proxyAuthHelper, as the base64(name:secret) the SDK sends
# as its api_key. Sets proxy_login.
read_proxy_login() {
  local helper="${IMAGEGEN_PROXY_AUTH_HELPER:-}" candidate login
  if [ -z "$helper" ]; then
    for candidate in /opt/claude-switch/proxy-auth-helper "$HOME/.claude-switch-proxy/proxy-auth-helper"; do
      if [ -x "$candidate" ]; then
        helper="$candidate"
        break
      fi
    done
  fi
  if [ -z "$helper" ]; then
    echo "imagegen: no proxyAuthHelper found (/opt/claude-switch/proxy-auth-helper, ~/.claude-switch-proxy/proxy-auth-helper); set IMAGEGEN_PROXY_AUTH_HELPER" >&2
    exit 1
  fi
  if ! login="$("$helper")"; then
    echo "imagegen: $helper failed; it prints the switch-proxy login this backend needs" >&2
    exit 1
  fi
  case "$login" in
    "Basic "?*) ;;
    *)
      echo "imagegen: $helper did not print a 'Basic …' login" >&2
      exit 1
      ;;
  esac
  # The SDK sends its api_key as a Bearer; the proxy reads base64(name:secret) from either.
  proxy_login="${login#Basic }"
}

no_proxy_here="no switch proxy here (CLAUDE_SWITCH_PARENT_HTTPS_PROXY is unset: this is not a claude-switch session); set IMAGEGEN_PROXY_URL, or choose IMAGEGEN_BACKEND=codex or api"

if [ "${1:-}" = "models" ]; then
  shift
  if [ "$backend" != subscription ]; then
    echo "backend $backend_says."
    echo "It has one provider, so there are no image classes to choose; they exist only under the switch proxy (IMAGEGEN_BACKEND=subscription)."
    exit 0
  fi
  proxy="${IMAGEGEN_PROXY_URL:-${CLAUDE_SWITCH_PARENT_HTTPS_PROXY:-}}"
  if [ -z "$proxy" ]; then
    echo "imagegen: $no_proxy_here" >&2
    exit 1
  fi
  read_proxy_login
  IMAGEGEN_PROXY_LOGIN="$proxy_login" IMAGEGEN_CLASS="$class" \
    exec uv run --quiet --no-project python3 "$here/models.py" "${proxy%/}/v1" "$@"
fi

case "$backend" in
  codex | subscription)
    case "$model" in
      gpt-image*) ;;
      *)
        echo "imagegen: the $backend backend chooses its own image model; --model must be a gpt-image model, not '$model'" >&2
        exit 1
        ;;
    esac
    ;;
esac
tool_model="gpt-image-2-codex (ChatGPT image tool)"

case "$backend" in
  codex)
    if [ -n "$dry_run" ]; then
      echo "imagegen: model $tool_model via Codex login (dry-run only; login not read)" >&2
      exec uv run --quiet --no-project --with openai --with pillow python3 "$here/image_gen.py" "$@"
    fi
    py="$(uv run --quiet --no-project python3 -c 'import sys; print(sys.executable)')"
    host="$("$py" "$here/codex_images.py" check)"
    echo "imagegen: model $tool_model via Codex login, hosted by $host" >&2
    port_file="$(mktemp "${TMPDIR:-/tmp}/imagegen-codex.XXXXXX")"
    key="$(od -An -tx1 -N24 /dev/urandom | tr -d ' \n')"
    IMAGEGEN_CODEX_KEY="$key" "$py" "$here/codex_images.py" serve --port-file "$port_file" &
    bridge=$!
    # wait reaps the bridge, so bash does not report it as "Terminated" after a successful run.
    trap 'kill "$bridge" 2>/dev/null || true; wait "$bridge" 2>/dev/null || true; rm -f "$port_file" "$port_file.tmp"' EXIT
    tries=0
    while [ ! -s "$port_file" ]; do
      if ! kill -0 "$bridge" 2>/dev/null || [ "$tries" -ge 200 ]; then
        echo "imagegen: the Codex bridge did not start listening" >&2
        exit 1
      fi
      tries=$((tries + 1))
      sleep 0.05
    done
    export OPENAI_BASE_URL="http://127.0.0.1:$(cat "$port_file")/v1"
    # The bridge is on loopback; an HTTP(S)_PROXY in the environment must not carry calls to it.
    export NO_PROXY="127.0.0.1${NO_PROXY:+,$NO_PROXY}" no_proxy="127.0.0.1${no_proxy:+,$no_proxy}"
    export OPENAI_API_KEY="$key"
    rc=0
    uv run --quiet --no-project --with openai --with pillow python3 "$here/image_gen.py" "$@" || rc=$?
    exit "$rc"
    ;;
  subscription)
    proxy="${IMAGEGEN_PROXY_URL:-${CLAUDE_SWITCH_PARENT_HTTPS_PROXY:-}}"
    if [ -z "$proxy" ] && [ -z "$dry_run" ]; then
      echo "imagegen: $no_proxy_here" >&2
      exit 1
    fi
    if [ -n "$class" ]; then
      echo "imagegen: via switch proxy ${proxy:-none (dry-run only)}, class $class; it picks the provider and model for each image from that class" >&2
    else
      echo "imagegen: via switch proxy ${proxy:-none (dry-run only)}; it picks the provider and model for each image" >&2
    fi
    if [ -n "$proxy" ]; then
      export OPENAI_BASE_URL="${proxy%/}/v1"
    fi
    if [ -z "$dry_run" ]; then
      read_proxy_login
      export OPENAI_API_KEY="$proxy_login"
    fi
    export IMAGEGEN_CLASS="$class"
    exec uv run --quiet --no-project --with openai --with pillow python3 "$here/served_by.py" "$@"
    ;;
  api)
    echo "imagegen: model $model via OpenAI API (OPENAI_API_KEY)" >&2
    ;;
esac

exec uv run --quiet --no-project --with openai --with pillow python3 "$here/image_gen.py" "$@"
